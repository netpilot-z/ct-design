{
  "name": "@ct-design/ui",
  "version": "0.1.0",
  "description": "Shared React UI components for the ct-design monorepo.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.less"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/index.less": "./dist/styles/index.less"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/netpilot-z/ct-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/netpilot-z/ct-design/tree/main/packages/ui",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-less-assets.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ct-design/tokens": "workspace:*"
  },
  "peerDependencies": {
    "antd": ">=5",
    "less": ">=4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ct-design/tsconfig": "workspace:*",
    "@ct-design/tsup-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "antd": "^5.27.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
