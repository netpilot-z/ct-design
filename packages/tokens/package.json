{
  "name": "@ct-design/tokens",
  "version": "0.1.0",
  "description": "Design tokens and theme helpers for the ct-design monorepo.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css/default.css": "./dist/css/default.css",
    "./css/dark.css": "./dist/css/dark.css",
    "./less/variables.less": "./dist/less/variables.less",
    "./less/dark.variables.less": "./dist/less/dark.variables.less",
    "./antd/default.json": "./dist/antd/default.json",
    "./antd/dark.json": "./dist/antd/dark.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/generate-assets.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ct-design/tsconfig": "workspace:*",
    "@ct-design/tsup-config": "workspace:*"
  }
}
