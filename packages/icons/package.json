{
  "name": "@ct-design/icons",
  "version": "0.1.1",
  "description": "Shared icon exports for the ct-design monorepo.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/netpilot-z/ct-design.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/netpilot-z/ct-design/tree/main/packages/icons",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('No tests for @ct-design/icons')\""
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ct-design/tsconfig": "workspace:*",
    "@ct-design/tsup-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
